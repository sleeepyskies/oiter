name: final
stages:
  vertex:
    name: vertex
    path: fullscreen.vert
  fragment:
    name: fragment
    source: |
      #version 460
      
      layout(location = 0) out vec4 out_color;
      
      layout(binding = 0) uniform sampler2D front_texture; // RGBA8
      layout(binding = 1) uniform sampler2D back_texture;  // RGB8

      void main() {
          const vec2 uv = gl_FragCoord.xy / vec2(textureSize(front_texture, 0));
          const vec4 input_front = texture(front_texture, uv);
          const vec3 input_back = texture(back_texture, uv).rgb;
          const float alpha = 1.f - input_front.a;
          
          // blend front over back, alpha is how much of the background is blocked by the front
          out_color.rgb = input_front.rgb + input_back * alpha;
          out_color.a = 1.f;
      }
