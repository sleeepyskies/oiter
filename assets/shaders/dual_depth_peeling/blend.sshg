name: blend
stages:
  vertex:
    name: vertex
    path: fullscreen.vert
  fragment:
    name: fragment
    source: |
      #version 460
      
      layout(location = 0) out vec4 out_color;
      
      layout(binding = 0) uniform sampler2D temp_texture; // the back texture

      void main() {
          const vec2 uv = gl_FragCoord.xy / vec2(textureSize(temp_texture, 0));
          // todo: add this check back in
          // if (color.a == 0.f) { discard; } // for the occlusion query
          out_color = texture(temp_texture, uv);
      }
