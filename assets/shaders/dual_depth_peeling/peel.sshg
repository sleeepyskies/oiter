name: peel
stages:
  vertex:
    name: vertex
    path: default.vert
  fragment:
    name: fragment
    source: !glsl |
      #version 460
      layout(location = 0) in vec4 v_position;
      layout(location = 1) in vec4 v_normal;
      layout(location = 2) in vec4 v_color;
      layout(location = 3) in vec2 v_texture;
      layout(location = 4) in vec4 v_tangent;
      
      struct BakedMaterial {
          vec4 color;
      };
      
      layout(std140, binding = 0) uniform SceneUniforms {
          mat4 projection_view;
          vec3 camera_position;
          float _pad0;
      };
      
      layout(std140, binding = 1) uniform MeshUniforms {
          BakedMaterial material;
          mat4 model;
      };
      
      // input textures
      layout(binding = 0) uniform sampler2D input_depth_texture; // RG32F depth min max thing
      layout(binding = 1) uniform sampler2D input_front_texture; // RGBA9 front
      
      // textues we writing to boi
      layout(location = 0) out vec2 out_depth;
      layout(location = 1) out vec4 out_front;
      layout(location = 2) out vec4 out_back;
      
      vec4 shade() {
          // todo: actual shading pls
          return material.color;
      }
      
      bool has_fragment_been_peeled(const float fragment_depth, const float nearest_layer, const float farthest_layer) {
          return fragment_depth < nearest_layer || fragment_depth > farthest_layer;
      }
      
      bool is_inside_peel_range(const float fragment_depth, const float nearest_layer, const float farthest_layer) {
          return fragment_depth > nearest_layer && fragment_depth < farthest_layer;
      }
      
      bool is_fragment_on_nearest_layer(const float fragment_depth, const float nearest_layer) {
          return fragment_depth == nearest_layer;
      }
      
      const float MAX_DEPTH = 1.f;

      void main() {
          const float fragment_depth = gl_FragCoord.z;
          const vec4 input_front = texture(input_front_texture, gl_FragCoord.xy / vec2(textureSize(input_front_texture, 0)));
          
          const float alpha_factor = 1.f - input_front.w;
          
          // the depth from previous pass at this uv coords
          const vec2 input_depth = texture(input_depth_texture, gl_FragCoord.xy / vec2(textureSize(input_depth_texture, 0))).xy;
          const float nearest_layer = -input_depth.x; // normalize again since we negated in previous pass
          const float farthest_layer = input_depth.y;
          
          out_depth.xy = input_depth;
          out_front = input_front;
          out_back = vec4(0.f);
          
          // CASE 1: this fragment is outside of our peel range and thus we can just ignore
          if (has_fragment_been_peeled(fragment_depth, nearest_layer, farthest_layer)) {
              // just write dummy value since we cannot discard
              out_depth.xy = vec2(-MAX_DEPTH);
              return;
          }
          
          // CASE 2: we are inside the peel range, but not on a layer, so setup next pass
          if (is_inside_peel_range(fragment_depth, nearest_layer, farthest_layer)) {
              // write depth to output depth texture to find the next layer for next pass
              // copying init pass kinda here
              out_depth.xy = vec2(-fragment_depth, fragment_depth);
              return;
          }
          
          // CSAE 3:
          // we know we are not inside range or outside, so we must be on one of the layers
          // so now we can shade this layer and prevent it from being in following passes
          const vec4 color = shade();
          
          if (is_fragment_on_nearest_layer(fragment_depth, nearest_layer)) {
              // todo: are these correct? its same as reference shader, but different from paper
              out_front.xyz += color.rgb * color.a * alpha_factor;
              out_front.w = 1.f - alpha_factor * (1.f - color.a);
          } else {
              out_back += color;
          }
          
          out_depth.xy = vec2(-MAX_DEPTH); // just write dummy value
      }
