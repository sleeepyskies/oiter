name: rg_to_rgba
stages:
  vertex:
    path: ../fullscreen.vert
  fragment:
    name: fragment
    source: |
      #version 460

      layout(binding = 0) uniform sampler2D t_texture;
      layout(location = 0) out vec4 out_color;

      void main() {
          // this is kinda linearizing the depth but not properly, some 
          // values have been tweaked to make it look better for visuals
          const ivec2 pixel = ivec2(gl_FragCoord.xy);
          float depth = clamp(texelFetch(t_texture, pixel, 0).r, 0, 1);
          depth = (200 / (1000.1 - depth * 999.9)) / 50;
          out_color = vec4(
              depth,
              depth,
              depth,
              1
          );
      }
