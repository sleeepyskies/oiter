name: blend
stages:
  vertex:
    name: vertex
    path: ../fullscreen.vert
  fragment:
    name: fragment
    source: |
      #version 460

      layout(location = 0) in vec2 v_texture;
      layout(location = 0) out vec4 out_color;
      layout(binding = 0) uniform sampler2D layer;
      
      struct BakedMaterial {
          vec4 color;
      };

      void main() {
          const vec4 rgba = texture(layer, v_texture);
          out_color.rgb = rgba.rgb * rgba.a;
          out_color.a = rgba.a;
      }
