name: gather
stages:
  vertex:
    name: vertex
    path: gather.vert
  fragment:
    name: fragment
    source: |
      #version 460
      
      struct BakedMaterial {
          vec4 color;
      };

      layout(std140, binding = 0) uniform SceneUniforms {
          mat4 projection_view;
          vec3 camera_position;
          float _pad0;
      };

      layout(std140, binding = 1) uniform MeshUniforms {
          BakedMaterial material;
          mat4 model;
      };

      layout(location = 0) in vec4 v_position;
      layout(location = 1) in vec4 v_normal;
      layout(location = 2) in vec4 v_color;
      layout(location = 3) in vec2 v_texture;
      layout(location = 4) in vec4 v_tangent;
      
      layout(location = 0) out vec4 out_color;
      
      /// the depth texture we use here us the depth buffer from the *previous* pass
      // basically this texture encodes the last peeled layer
      layout(binding = 0) uniform sampler2D depth_texture;

      void main() {
          // retrieve the depth layer
          const float previous_layer_depth = texelFetch(depth_texture, ivec2(gl_FragCoord.xy), 0).r;
          
          // check if already peeled
          if (gl_FragCoord.z <= previous_layer_depth) { 
              discard;
          }
          
          out_color = material.color;
      }
