name: gather_first
stages:
  vertex:
    name: vertex
    path: gather.vert
  fragment:
    name: fragment
    source: |
      #version 460

      layout(location = 0) in vec4 v_color;
      
      layout(location = 0) out vec4 out_color;

      void main() {
          // the first 'gather' pass is just required to render the top layer
          // of objects. so we do a simple pass pass (um)
          out_color = v_color;
      }
