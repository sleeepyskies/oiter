name: gather
stages:
  vertex:
    name: vertex
    source: !glsl |
      #version 460

      layout(std140, binding = 0) uniform SceneUniforms {
          mat4 projection_view;
          vec3 camera_position;
          float _pad0;
      };
      
      struct BakedMaterial {
          vec4 color;
      };
      
      layout(std140, binding = 1) uniform MeshUniforms {
          BakedMaterial material;
          mat4 model;
      };

      layout(location = 0) in vec4 a_position;

      void main() {
          gl_Position = projection_view * model * a_position;
      }
  fragment:
    name: fragment
    source: !glsl |
      #version 460
      #extension GL_KHR_shader_subgroup_basic : require
      #extension GL_KHR_shader_subgroup_arithmetic : require
      #extension GL_KHR_shader_subgroup_ballot : require
      
      struct BakedMaterial {
          vec4 color;
      };

      layout(std140, binding = 0) uniform SceneUniforms {
          mat4 projection_view;
          vec3 camera_position;
          float _pad0;
      };

      layout(std140, binding = 1) uniform MeshUniforms {
          BakedMaterial material;
          mat4 model;
      };
      
      struct Node {
          vec4 color;
          float depth;
          uint next;
      };
      
      layout(std430, binding = 0) buffer linked_list {
          uint counter;
          Node[] nodes;
      };
      
      layout(r32ui, binding = 0) uniform uimage2D heads;

      uint next_index() {
          //return atomicAdd(counter, 1);
          subgroupMemoryBarrier();
          uint count = subgroupAdd(1u);
          uint base = 0;
          subgroupMemoryBarrier();
          if (subgroupElect() && count > 0) {
              subgroupMemoryBarrier();
              base = atomicAdd(counter, count);
              subgroupMemoryBarrier();
          }
          subgroupMemoryBarrier();
          base = subgroupBroadcastFirst(base);
          subgroupMemoryBarrier();
          uint index = base + subgroupExclusiveAdd(1u);
          subgroupMemoryBarrier();
          return index;
      }
      
      void main() {
          const ivec2 pixel = ivec2(gl_FragCoord.xy);      
          
          if (gl_SubgroupInvocationID > 0) {
              discard;
          }
          
          subgroupMemoryBarrier();
          uint count = subgroupAdd(1u);
          uint base = 0;
          subgroupMemoryBarrier();
          if (subgroupElect() && count > 0) {
              subgroupMemoryBarrier();
              base = atomicAdd(counter, 32);
              base = atomicAdd(counter, 1);
              subgroupMemoryBarrier();
          }
          subgroupMemoryBarrier();
          base = subgroupBroadcastFirst(base);
          subgroupMemoryBarrier();
          uint index = base + subgroupExclusiveAdd(1u);
          subgroupMemoryBarrier();
          
          //const uint index = next_index();
          
          if (index >= uint(nodes.length())) {
              discard;
          }
          
          const uint old = imageAtomicExchange(heads, pixel, index);
          
          vec4 debug_color = vec4(1.0, 0, 0, 1.0);      
          vec4 pink;
          if (subgroupElect()) {
              debug_color = vec4(0, 1.0, 0, 1.0);
              pink = vec4(1, 0, 1, 1.0);
          }
          uint ii = subgroupExclusiveAdd(1u);
          debug_color.x = (float((ii / 4) % 8)) / 8.0f;
          debug_color.y = (float((ii / 2) % 8)) / 8.0f;
          debug_color.z = (float((ii    ) % 8)) / 8.0f;
          pink = subgroupBroadcastFirst(pink);
          debug_color = pink;
          
          nodes[index].color = material.color;
          nodes[index].color = debug_color;
          nodes[index].depth = gl_FragCoord.z;
          nodes[index].next = old;
      }
