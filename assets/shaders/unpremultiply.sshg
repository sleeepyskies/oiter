name: skybox
stages:
  vertex:
    path: ./fullscreen.vert
  fragment:
    name: fragment
    source: |
      #version 460

      layout(binding = 0) uniform sampler2D t_linear;
      layout(location = 0) out vec4 out_color;

      void main() {
          const ivec2 pixel = ivec2(gl_FragCoord.xy);
          out_color = texelFetch(t_linear, pixel, 0);
          if (out_color.a != 0) {
              out_color.rgb = out_color.rgb / out_color.a;
          }
      }
