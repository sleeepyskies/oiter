name: dither
stages:
  vertex:
    name: vertex
    source: !glsl |
      #version 460

      layout(std140, binding = 0) uniform SceneUniforms {
          mat4 projection_view;
          vec3 camera_position;
          float _pad0;
      };

      struct BakedMaterial {
          vec4 color;
      };
 
      layout(std140, binding = 1) uniform MeshUniforms {
          BakedMaterial material;
          mat4 model;
      };

      layout(location = 0) in vec4 a_position;

      void main() {
          gl_Position = projection_view * model * a_position;
      }
  fragment:
    name: fragment
    source: !glsl |
      #version 460
 
      struct BakedMaterial {
          vec4 color;
      };

      layout(std140, binding = 0) uniform SceneUniforms {
          mat4 projection_view;
          vec3 camera_position;
          float _pad0;
      };

      layout(std140, binding = 1) uniform MeshUniforms {
          BakedMaterial material;
          mat4 model;
      };

      layout(std140, binding = 2) uniform ScreenDoorUniforms {
          uint size;
      };

      layout(location = 0) out vec4 out_color;

      const float[4] bayer4 = float[4](
          0.0  / 4.0,  2.0  / 4.0,
          3.0  / 4.0,  1.0  / 4.0
      );

      const float[16] bayer16 = float[16](
          1.0  / 17.0,  9.0  / 17.0,  3.0  / 17.0,  11.0 / 17.0,
          13.0 / 17.0,  5.0  / 17.0,  15.0 / 17.0,  7.0  / 17.0,
          4.0  / 17.0,  12.0 / 17.0,  2.0  / 17.0,  10.0 / 17.0,
          16.0 / 17.0,  8.0  / 17.0,  14.0 / 17.0,  6.0  / 17.0
      );

      const float bayer64[64] = float[64](
          1.0 / 65.0, 33.0 / 65.0,  9.0 / 65.0, 41.0 / 65.0,
          3.0 / 65.0, 35.0 / 65.0, 11.0 / 65.0, 43.0 / 65.0,

          49.0 / 65.0, 17.0 / 65.0, 57.0 / 65.0, 25.0 / 65.0,
          51.0 / 65.0, 19.0 / 65.0, 59.0 / 65.0, 27.0 / 65.0,

          13.0 / 65.0, 45.0 / 65.0,  5.0 / 65.0, 37.0 / 65.0,
          15.0 / 65.0, 47.0 / 65.0,  7.0 / 65.0, 39.0 / 65.0,

          61.0 / 65.0, 29.0 / 65.0, 53.0 / 65.0, 21.0 / 65.0,
          63.0 / 65.0, 31.0 / 65.0, 55.0 / 65.0, 23.0 / 65.0,

          4.0 / 65.0, 36.0 / 65.0, 12.0 / 65.0, 44.0 / 65.0,
          2.0 / 65.0, 34.0 / 65.0, 10.0 / 65.0, 42.0 / 65.0,

          52.0 / 65.0, 20.0 / 65.0, 60.0 / 65.0, 28.0 / 65.0,
          50.0 / 65.0, 18.0 / 65.0, 58.0 / 65.0, 26.0 / 65.0,

          16.0 / 65.0, 48.0 / 65.0,  8.0 / 65.0, 40.0 / 65.0,
          14.0 / 65.0, 46.0 / 65.0,  6.0 / 65.0, 38.0 / 65.0,

          64.0 / 65.0, 32.0 / 65.0, 56.0 / 65.0, 24.0 / 65.0,
          62.0 / 65.0, 30.0 / 65.0, 54.0 / 65.0, 22.0 / 65.0
      );

      void main() {
          int gridsize = (size == 0) ? 2 : ((size == 1) ? 4 : 8);

          const ivec2 cell = ivec2(gl_FragCoord.xy) % ivec2(gridsize);

          float threshold;

          if (size == 0) {
              threshold = bayer4[cell.y * gridsize + cell.x];
          } else if (size == 1) {
              threshold = bayer16[cell.y * gridsize + cell.x];
          } else {
              threshold = bayer64[cell.y * gridsize + cell.x];
          }

          if (threshold >= material.color.a) {
              discard;
          }

          out_color = vec4(material.color.rgb, 1.f);
      }

